# ==============================================================================
# IOI AI — Backend (Node/Express) Environment Configuration
# Copy this file to .env and configure for your environment.
# ==============================================================================

# ── 1. SERVER CONFIGURATION ───────────────────────────────────────────────────

# HTTP Port for Node/Express server (default: 5001 locally, Render sets PORT automatically)
PORT=5001

# Allowed CORS origins (comma-separated for multiple, default: * for local dev)
# Production example: https://your-project.vercel.app
CORS_ORIGIN=*

# ── 2. DATABASE CONFIGURATION (MongoDB Atlas) ─────────────────────────────────

# MongoDB connection URI (Required)
# Development (Local):  mongodb://localhost:27017/ioi_ai
# Production (Atlas):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ioi_ai
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ioi_ai

# ── 3. RAG SERVICE PROXY CONFIGURATION ────────────────────────────────────────

# URL of the Python FastAPI RAG service (Required)
# Local development default: http://localhost:8000
# Production (Hugging Face Space): https://<your-username>-<your-space-name>.hf.space
RAG_SERVICE_URL=http://localhost:8000

# Optional: Bearer token if Hugging Face Space is set to Private
# RAG_SERVICE_AUTH_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Request timeout in milliseconds (default: 60000)
RAG_SERVICE_TIMEOUT_MS=60000
