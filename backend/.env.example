# ==============================================================================
# IOI AI — Backend (Node/Express) Environment Configuration
# Copy this file to .env and configure for your environment.
# ==============================================================================

# ── 1. SERVER CONFIGURATION ───────────────────────────────────────────────────

# HTTP Port for Node/Express server (default: 5001)
PORT=5001

# Allowed CORS origins (comma-separated for multiple, default: * for local dev)
# Production example: https://ioi-ai.yourdomain.com
CORS_ORIGIN=*

# ── 2. DATABASE CONFIGURATION (MongoDB) ────────────────────────────────────────

# MongoDB connection URI (Required)
# Development (Local):  mongodb://localhost:27017/ioi_ai
# Production (Atlas):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ioi_ai
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ioi_ai

# ── 3. INTERNAL RAG SERVICE PROXY ─────────────────────────────────────────────

# URL of the local/internal Python FastAPI RAG service (Required)
# Local development default: http://localhost:8000
# Production: internal network address of the FastAPI service (e.g. http://rag-service:8000)
RAG_SERVICE_URL=http://localhost:8000
