# ==============================================================================
# IOI AI — Frontend (Next.js) Environment Configuration
# Copy this file to .env.local and configure for your environment.
# ==============================================================================

# ── 1. API BACKEND ENDPOINT (Required) ────────────────────────────────────────

# Public URL of the Node/Express backend proxy.
# The NEXT_PUBLIC_ prefix makes this accessible in browser-side client bundles.
#
# IMPORTANT ARCHITECTURAL CONSTRAINT:
# The frontend client NEVER calls the Python FastAPI service,
# MongoDB Atlas, or Ollama directly. All requests route
# exclusively through the Node/Express proxy layer.
#
# Local development default: http://localhost:5001
# Production (Render):       https://ioi-ai-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5001
