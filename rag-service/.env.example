# ==============================================================================
# IOI AI — RAG Service Environment Configuration
# Copy this file to .env and configure for your environment.
# ==============================================================================

# ── 1. REQUIRED VARIABLES ─────────────────────────────────────────────────────

# MongoDB Atlas connection string (read-only access to ioi_ai database)
# Dev: local mongodb:// or Atlas URI | Prod: MongoDB Atlas URI with secure credentials
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ioi_ai
MONGODB_DATABASE=ioi_ai

# ── 2. LLM RUNTIME (OLLAMA / HUGGING FACE) ────────────────────────────────────

# LLM provider: 'ollama' (default for local development) or 'huggingface' (cloud deployment)
LLM_PROVIDER=ollama

# Local Ollama configuration (used when LLM_PROVIDER=ollama)
# Base URL for Ollama service (defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model tag (must be pulled via 'ollama pull llama3.2:1b')
OLLAMA_MODEL=llama3.2:1b
# HTTP request timeout in seconds (default: 120; accounts for initial cold start)
OLLAMA_TIMEOUT_SECONDS=120

# Hugging Face Inference configuration (used when LLM_PROVIDER=huggingface)
# Free User Access Token from https://huggingface.co/settings/tokens
HF_TOKEN=
# Target model tag for serverless chat completion
HF_MODEL=meta-llama/Llama-3.2-1B-Instruct
# HTTP request timeout in seconds for Hugging Face inference requests (default: 30)
HF_TIMEOUT_SECONDS=30

# ── 3. EMBEDDINGS CONFIGURATION ───────────────────────────────────────────────

# Embedding provider: 'sentence-transformers' (default, local 384d), 'fastembed' (ONNX, 384d), 'openai', or 'ollama'
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FastEmbed configuration alternative (offline ONNX runtime, 384 dimensions)
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Cloud embeddings provider alternative (requires API key)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=your_api_key_here

# Local Ollama embedding alternative
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBED_MODEL=all-minilm

# ── 4. VECTOR STORE CONFIGURATION (ChromaDB) ──────────────────────────────────

# Path to persistent ChromaDB directory
# Local default: ../data/vectorstore
# Hugging Face Space deployment: data/vectorstore_hf (or /home/user/app/data/vectorstore_hf)
VECTOR_STORE_PATH=../data/vectorstore

# ── 5. RETRIEVAL & FILTERING THRESHOLDS ───────────────────────────────────────

# Default top-K records returned when unspecified by client (default: 5)
TOP_K_DEFAULT=5
# Hard upper ceiling for top-K (default: 50; protects memory and LLM context window)
TOP_K_MAX=50
# Minimum cosine similarity threshold (default: 0.58; calibrated on FastEmbed 384d)
SIMILARITY_THRESHOLD=0.58

# ── 6. SERVICE NETWORKING ─────────────────────────────────────────────────────

# Port the FastAPI service listens on (Local: 8000, Hugging Face Spaces: 7860)
PORT=8000

# Allowed CORS origins (comma-separated for multiple, default: * for local dev)
# Production example: http://backend:5001,https://api.yourdomain.com
CORS_ORIGIN=*
